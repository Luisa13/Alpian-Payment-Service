{
  "title": "Payment Service — Template Dashboard",
  "uid": "payment-service-template",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 2,
        "hide": 0
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\"}[1m])) by (uri, method, status)",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 2,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\", status=~\"5..\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },

    {
      "id": 3,
      "title": "HTTP Latency p50/p95/p99",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\"}[1m])) by (le, uri))",
          "legendFormat": "p50 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\"}[1m])) by (le, uri))",
          "legendFormat": "p95 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\"}[1m])) by (le, uri))",
          "legendFormat": "p99 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },

    {
      "id": 10,
      "title": "Transfers Created (rate)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(transfers_created_total{application=~\"$application\"}[1m])) by (currency)",
          "legendFormat": "{{currency}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 11,
      "title": "Transfers Settled (rate)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(transfers_settled_total{application=~\"$application\"}[1m]))",
          "legendFormat": "settled/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "fixedColor": "green", "mode": "fixed" } }
      }
    },

    {
      "id": 12,
      "title": "Transfers Failed (rate)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(transfers_failed_total{application=~\"$application\"}[1m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "fixedColor": "orange", "mode": "fixed" } }
      }
    },

    {
      "id": 13,
      "title": "Outbox Backlog",
      "type": "stat",
      "gridPos": { "x": 18, "y": 8, "w": 3, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "outbox_backlog_events{application=~\"$application\"}",
          "legendFormat": "backlog"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },

    {
      "id": 14,
      "title": "DLT Messages",
      "type": "stat",
      "gridPos": { "x": 21, "y": 8, "w": 3, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(transfers_dlt_messages_total{application=~\"$application\"})",
          "legendFormat": "DLT"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      }
    },

    {
      "id": 20,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=~\"$application\", area=\"heap\"}) by (id)",
          "legendFormat": "{{id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },

    {
      "id": 21,
      "title": "JVM GC Pause Rate",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 15, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=~\"$application\"}[1m])",
          "legendFormat": "{{action}} {{cause}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 22,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=~\"$application\"}",
          "legendFormat": "live"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=~\"$application\"}",
          "legendFormat": "daemon"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 30,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_lag{application=~\"$application\"}) by (topic, partition)",
          "legendFormat": "{{topic}}[{{partition}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },

    {
      "id": 31,
      "title": "Kafka Producer Send Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(kafka_producer_topic_record_send_total{application=~\"$application\"}[1m])) by (topic)",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }

  ]
}
